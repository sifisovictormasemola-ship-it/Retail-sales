{
  "datasets": [
    {
      "name": "8062c908",
      "displayName": "Retail Sales Performance and Customer Insights Dataset",
      "queryLines": [
        "USE CATALOG `workspace`;\n",
        "USE SCHEMA `default`;\n",
        "\n",
        "select *\n",
        "from `retail`.`sales`.`dataset`;\n",
        "\n",
        "\n",
        "SELECT COUNT(DISTINCT`customer id`) AS Unique_customer,-- Counting different customers in my column date.\n",
        "Date,\n",
        "YEAR (Date) AS trans_year,--Extract the month in the column date.\n",
        "MONTH(Date) AS trans_month,--Extract the month from the column date.\n",
        "MONTHNAME(Date) AS trans_month_name,--Extract the month name from the column date.\n",
        "DAY(Date) AS trans_day,--Extract the day from the column date.\n",
        "DAYNAME(Date) AS trans_day_name,--Extract the name of the day from the colum date.\n",
        "SUM(`Total amount`) AS revenue,--Calculate the total revenue. \n",
        "`Product Category`\n",
        "from `retail`.`sales`.`dataset`\n",
        "GROUP BY ALL;--Grouping my data based on all the columns that are not agggregated in my SELECT statement."
      ]
    }
  ],
